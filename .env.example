# --- Database (Neon, Supabase of lokale Postgres) ---
# postgres.js connection string. Voor Neon: gebruik de "pooled" URL.
DATABASE_URL="postgresql://user:password@host:5432/verkenners?sslmode=require"

# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Webhook signing secret voor de user/org-sync (Clerk Dashboard > Webhooks)
CLERK_WEBHOOK_SECRET="whsec_..."

# Clerk redirect-routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"
